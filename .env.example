# Netlify Database provisions and injects NETLIFY_DB_URL into deployed functions.
# Do not add a production connection string to this file or expose it to Vite.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
STOREFRONT_ORIGIN=https://YOUR-STOREFRONT-SITE.netlify.app
ADMIN_ORIGIN=https://YOUR-ADMIN-SITE.netlify.app
# Use false only for local HTTP development. Production must keep this true.
COOKIE_SECURE=true
# Build-time, non-secret values; set when building after creating the Netlify sites.
API_SITE_ORIGIN=https://YOUR-STOREFRONT-SITE.netlify.app
SITE_ORIGIN=https://YOUR-STOREFRONT-SITE.netlify.app
VITE_STOREFRONT_ORIGIN=https://YOUR-STOREFRONT-SITE.netlify.app
